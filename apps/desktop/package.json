{
  "name": "@ezychat/desktop",
  "productName": "EzyChat Lite",
  "version": "0.1.45",
  "type": "module",
  "license": "MIT",
  "description": "EzyChat core: the Electron desktop shell (window, tray, status window, OS service, updater).",
  "author": "OSS Malaysia and contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossmalaysia/ezychat-lite.git",
    "directory": "apps/desktop"
  },
  "homepage": "https://ezychat.ai/",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/main.js",
  "exports": {
    ".": {
      "ezychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "ezychat-fetch-cloudflared": "scripts/fetch-cloudflared.mjs",
    "ezychat-fetch-winsw": "scripts/fetch-winsw.mjs"
  },
  "files": [
    "dist",
    "!dist/server",
    "!dist/package.json",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "scripts/fetch-common.mjs",
    "scripts/fetch-cloudflared.mjs",
    "scripts/fetch-winsw.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build -w @ezychat/web && node ../../scripts/bundle-server.mjs && node scripts/build.mjs && electron .",
    "dist": "node scripts/fetch-cloudflared.mjs && node scripts/fetch-winsw.mjs && npm run build -w @ezychat/web && node ../../scripts/bundle-server.mjs && node scripts/build.mjs && electron-builder --config electron-builder.yml",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "bundle:server": "node ../../scripts/bundle-server.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "better-sqlite3": "^13.0.3",
    "sherpa-onnx-node": "1.13.8",
    "sudo-prompt": "^9.2.1"
  },
  "peerDependencies": {
    "electron": ">=44"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  }
}
