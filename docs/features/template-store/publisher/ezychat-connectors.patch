diff --git a/scripts/build-templates.mjs b/scripts/build-templates.mjs
new file mode 100644
index 0000000..f3e3687
--- /dev/null
+++ b/scripts/build-templates.mjs
@@ -0,0 +1,178 @@
+#!/usr/bin/env node
+// PROPOSAL for anchorsprint/ezychat-connectors (see README.md next to this file): builds and signs
+// the AI agent template list from the repo's templates/ folder.
+//
+//   node build-templates.mjs --templates templates --schema schema/template-v1.json \
+//     --out dist/templates --sequence <n>
+//
+// 1. Reads templates/categories.json and every templates/<id>/ folder (template.json plus
+//    <lang>/focus.md, handoff-rules.md, context.md), assembles one entry per folder.
+// 2. Checks every entry against the JSON Schema (generated by scripts/template-schema.mjs in
+//    ezychat-lite) and the cross checks the schema cannot express: folder name = id, unique ids,
+//    known category, English texts present, a language folder only with its texts.
+// 3. Writes <out>/templates-v1.json; with TEMPLATE_LIST_SIGNING_KEY (Ed25519 private key, PKCS#8
+//    PEM, the connector list's key) also <out>/templates-v1.json.sig = base64 Ed25519 signature of
+//    "ezychat-templates-v1\n" + the exact file bytes.
+// Paths must be inside the working folder or the system temp folder.
+import { createPrivateKey, sign } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { isAbsolute, join, relative, resolve } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+export const SIGNING_CONTEXT = 'ezychat-templates-v1\n';
+export const LANGUAGES = ['en', 'ms', 'zh-CN'];
+const TEXT_FILES = {
+  focus: 'focus.md',
+  handoffRules: 'handoff-rules.md',
+  contextText: 'context.md',
+};
+const CATEGORY_ID = /^[a-z][a-zA-Z0-9-]{1,39}$/;
+
+/** Resolves `path` and accepts it only inside the working folder or the temp folder. */
+export function safePath(path, cwd = process.cwd()) {
+  const full = resolve(cwd, path);
+  const inside = (base) => {
+    const rel = relative(base, full);
+    return rel === '' || (!rel.startsWith('..') && !isAbsolute(rel));
+  };
+  if (!inside(resolve(cwd)) && !inside(resolve(tmpdir())))
+    throw new Error(`refusing a path outside the working folder or the temp folder: ${full}`);
+  return full;
+}
+
+/** A text file without its final newline (editors add one). */
+const readText = (path) => readFileSync(path, 'utf8').replace(/\r?\n$/, '');
+
+/** Assembles the entries and categories; returns them with every problem found. */
+export function assemble(templatesDir) {
+  const problems = [];
+  const categories = JSON.parse(readFileSync(join(templatesDir, 'categories.json'), 'utf8'));
+  const categoryIds = new Set();
+  for (const category of categories) {
+    if (!CATEGORY_ID.test(category?.id ?? '') || typeof category?.name?.en !== 'string')
+      problems.push(`categories.json: bad category ${JSON.stringify(category?.id)}`);
+    else if (categoryIds.has(category.id)) problems.push(`categories.json: ${category.id} twice`);
+    categoryIds.add(category?.id);
+  }
+  const entries = [];
+  const folders = readdirSync(templatesDir)
+    .filter((name) => statSync(join(templatesDir, name)).isDirectory())
+    .sort();
+  for (const folder of folders) {
+    const dir = join(templatesDir, folder);
+    const meta = JSON.parse(readFileSync(join(dir, 'template.json'), 'utf8'));
+    if (meta.id !== folder)
+      problems.push(`${folder}: id ${JSON.stringify(meta.id)} must match the folder`);
+    if (!categoryIds.has(meta.category))
+      problems.push(
+        `${folder}: category ${JSON.stringify(meta.category)} is not in categories.json`,
+      );
+    const texts = {};
+    for (const lang of LANGUAGES) {
+      const short = meta.texts?.[lang];
+      const langDir = join(dir, lang);
+      if (!short && !existsSync(langDir)) continue;
+      if (!short || !existsSync(langDir)) {
+        problems.push(
+          `${folder}: ${lang} needs both texts in template.json and the ${lang}/ folder`,
+        );
+        continue;
+      }
+      const long = {};
+      for (const [field, file] of Object.entries(TEXT_FILES)) {
+        const path = join(langDir, file);
+        if (existsSync(path)) long[field] = readText(path);
+        else problems.push(`${folder}: missing ${lang}/${file}`);
+      }
+      texts[lang] = { ...short, ...long };
+    }
+    if (!texts.en) problems.push(`${folder}: English texts are required`);
+    entries.push({ ...meta, texts });
+  }
+  const ids = new Set();
+  for (const entry of entries) {
+    if (ids.has(entry.id)) problems.push(`${entry.id}: id used twice`);
+    ids.add(entry.id);
+  }
+  return { categories, entries, problems };
+}
+
+/**
+ * A validator from the JSON Schema with ajv 8 (a devDependency of the publishing repo): returns the
+ * problems of one entry as text, none when it passes.
+ */
+export async function ajvValidator(schema) {
+  const { default: Ajv2020 } = await import('ajv/dist/2020.js');
+  const validate = new Ajv2020({ allErrors: true, strict: false }).compile(schema);
+  return (entry) =>
+    validate(entry)
+      ? []
+      : (validate.errors ?? []).map((e) => `${e.instancePath || '/'} ${e.message}`);
+}
+
+/** The list file bytes (stable key order, one trailing newline). */
+export function listBytes({ sequence, generatedAt, categories, entries }) {
+  return Buffer.from(
+    `${JSON.stringify({ format: 1, catalog: 'templates', generatedAt, sequence, categories, entries }, null, 2)}\n`,
+  );
+}
+
+/** Base64 Ed25519 signature over the signing context + the exact bytes. */
+export function signList(bytes, privateKey) {
+  const key = typeof privateKey === 'string' ? createPrivateKey(privateKey) : privateKey;
+  return `${sign(null, Buffer.concat([Buffer.from(SIGNING_CONTEXT), bytes]), key).toString('base64')}\n`;
+}
+
+/**
+ * The whole build; throws with every problem when the folder is not publishable. `validate` checks
+ * one entry (default: ajv with the JSON Schema at `schema`).
+ */
+export async function build({
+  templates,
+  schema,
+  out,
+  sequence,
+  generatedAt,
+  signingKey,
+  validate,
+}) {
+  if (!Number.isInteger(sequence) || sequence < 1)
+    throw new Error('--sequence must be a whole number ≥ 1');
+  const { categories, entries, problems } = assemble(safePath(templates));
+  const check =
+    validate ?? (await ajvValidator(JSON.parse(readFileSync(safePath(schema), 'utf8'))));
+  for (const entry of entries)
+    for (const problem of check(entry)) problems.push(`${entry.id}: ${problem}`);
+  if (problems.length) throw new Error(`template list not built:\n- ${problems.join('\n- ')}`);
+  const bytes = listBytes({ sequence, generatedAt, categories, entries });
+  const dir = safePath(out);
+  mkdirSync(dir, { recursive: true });
+  writeFileSync(join(dir, 'templates-v1.json'), bytes);
+  if (signingKey) writeFileSync(join(dir, 'templates-v1.json.sig'), signList(bytes, signingKey));
+  return { entries: entries.length, categories: categories.length, signed: Boolean(signingKey) };
+}
+
+function args(argv) {
+  const result = {};
+  for (let i = 0; i < argv.length; i += 2) result[argv[i].replace(/^--/, '')] = argv[i + 1];
+  return result;
+}
+
+if (import.meta.url === pathToFileURL(process.argv[1] ?? '').href) {
+  const a = args(process.argv.slice(2));
+  try {
+    const result = await build({
+      templates: a.templates ?? 'templates',
+      schema: a.schema ?? 'schema/template-v1.json',
+      out: a.out ?? 'dist/templates',
+      sequence: Number(a.sequence),
+      generatedAt: new Date().toISOString(),
+      signingKey: process.env.TEMPLATE_LIST_SIGNING_KEY || null,
+    });
+    process.stdout.write(`${JSON.stringify(result)}\n`);
+  } catch (err) {
+    process.stderr.write(`${err.message}\n`);
+    process.exitCode = 1;
+  }
+}
