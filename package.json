{
  "name": "ezychat-lite",
  "version": "0.1.62",
  "private": true,
  "description": "EzyChat Lite - a free, self-hosted WhatsApp team inbox that runs on your computer. You own your data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/wa",
    "packages/server",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w @ezychat/shared -w @ezychat/wa -w @ezychat/server && npm run build:lib -w @ezychat/web && npm run build -w @ezychat/desktop",
    "pack:core": "node scripts/pack-core.mjs",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage --testTimeout=20000",
    "coverage:changed": "node scripts/changed-lines-coverage.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "dev": "concurrently -k -n server,web -c green,cyan \"npm run dev -w @ezychat/server\" \"npm run dev -w @ezychat/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:electron-links": "node e2e/run-electron-links.mjs",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ossmalaysia/ezychat-lite.git"
  },
  "homepage": "https://ezychat.ai/"
}
