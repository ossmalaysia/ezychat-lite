{
  "name": "ezychat-lite",
  "version": "0.1.15",
  "private": true,
  "description": "EzyChat Lite - a free, self-hosted WhatsApp team inbox that runs on your computer. You own your data.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/wa",
    "packages/server",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "dev": "concurrently -k -n server,web -c green,cyan \"npm run dev -w @wa-team-inbox/server\" \"npm run dev -w @wa-team-inbox/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ossmalaysia/ezychat-lite.git"
  },
  "homepage": "https://ezychat.ai/"
}
