{
  "name": "@ezychat/server",
  "version": "0.1.39",
  "type": "module",
  "description": "EzyChat core: the inbox server (Fastify, Socket.IO, SQLite) and its extension API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossmalaysia/ezychat-lite.git",
    "directory": "packages/server"
  },
  "homepage": "https://ezychat.ai/",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "ezychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts --data ../../data/dev --fake-wa --mode dev --port 7420",
    "start": "tsx src/cli.ts",
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.86",
    "@ezychat/shared": "0.1.39",
    "@ezychat/wa": "0.1.39",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@node-rs/argon2": "^2.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "ai": "7.0.130",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "file-type": "^22.1.1",
    "mammoth": "^1.13.0",
    "mime-types": "^3.0.2",
    "ogg-opus-decoder": "1.7.5",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "qrcode": "^1.5.4",
    "sherpa-onnx-node": "1.13.8",
    "socket.io": "^4.8.4",
    "unpdf": "^1.8.1",
    "web-push": "^3.6.7",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "socket.io-client": "^4.8.4"
  }
}
