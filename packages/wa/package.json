{
  "name": "@ezychat/wa",
  "version": "0.1.45",
  "type": "module",
  "description": "EzyChat core: WhatsApp adapter interface, Baileys adapter and fake adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ossmalaysia/ezychat-lite.git",
    "directory": "packages/wa"
  },
  "homepage": "https://ezychat.ai/",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "ezychat-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ezychat/shared": "0.1.45",
    "baileys": "^7.0.0-rc14",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6"
  }
}
