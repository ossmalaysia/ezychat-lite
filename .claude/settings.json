{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/learnings-gate.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking LEARNINGS.md is up to date"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/review-nudge.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
